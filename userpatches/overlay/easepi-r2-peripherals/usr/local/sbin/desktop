#!/usr/bin/env bash
set -euo pipefail

CONF_FILE="/etc/easepi-r2-desktop.env"

if [ ! -r "${CONF_FILE}" ]; then
    echo "Desktop profile is not configured for this image."
    exit 1
fi

. "${CONF_FILE}"

DESKTOP_USER="${DESKTOP_USER:-}"
DESKTOP_SESSION="${DESKTOP_SESSION:-xfce}"
DESKTOP_TARGET="${DESKTOP_TARGET:-graphical.target}"
DESKTOP_GREETER="${DESKTOP_GREETER:-lightdm}"

if [ -z "${DESKTOP_USER}" ]; then
    echo "Desktop user is not configured."
    exit 1
fi

if ! id -u "${DESKTOP_USER}" >/dev/null 2>&1; then
    echo "Desktop user '${DESKTOP_USER}' does not exist."
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    exec sudo /usr/local/sbin/desktop "$@"
fi

systemctl enable "${DESKTOP_GREETER}.service" >/dev/null 2>&1 || true
systemctl start "${DESKTOP_GREETER}.service" >/dev/null 2>&1 || systemctl isolate "${DESKTOP_TARGET}"
