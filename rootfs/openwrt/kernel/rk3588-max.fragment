# Linux 6.18 kernel feature fragment for EasePi R2 OpenWrt rk3588-max.
#
# This is a desired Kconfig fragment for the custom RK3588 kernel line. Symbols
# provided only by Rockchip/vendor patches may be ignored until those patches are
# present in the OpenWrt kernel tree.

# Containers, LXC, Docker, and redroid prerequisites
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_OVERLAY_FS=m
CONFIG_FUSE_FS=m
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=m
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# KVM, VFIO, passthrough, and virtio
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST=m
CONFIG_VHOST_NET=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_PLATFORM=m
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_IO_PGTABLE_LPAE=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y
CONFIG_VIRTIO=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BLK=m
CONFIG_SCSI_VIRTIO=m
CONFIG_DRM_VIRTIO_GPU=m

# Router, VPN, nftables, and virtual networking
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VLAN_8021Q=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_BONDING=m
CONFIG_DUMMY=m
CONFIG_IFB=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_FIB_INET=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_WIREGUARD=m
CONFIG_XFRM_USER=m
CONFIG_NET_KEY=m
CONFIG_INET_ESP=m
CONFIG_INET_AH=m
CONFIG_INET_IPCOMP=m

# RK3588 display, GPU, VPU, RGA, DMA-BUF, and NPU
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=m
CONFIG_DRM_PANTHOR=m
CONFIG_DRM_PANFROST=m
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=m
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_ROCKCHIP_RGA=m
CONFIG_VIDEO_ROCKCHIP_VDEC=m
CONFIG_VIDEO_HANTRO=m
CONFIG_ROCKCHIP_RKNPU=m
CONFIG_ROCKCHIP_RKNPU_DMA_HEAP=y

# Vendor GPU/NPU symbols, enabled when the Rockchip vendor stack is present.
CONFIG_MALI_BIFROST=m
CONFIG_MALI_CSF_SUPPORT=y
CONFIG_MALI_PLATFORM_NAME="rk"

# USB, 4G/5G modems, Bluetooth, Wi-Fi, HID, and IR
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PLATFORM=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_ACM=m
CONFIG_USB_WDM=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIBTUSB=m
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMUTIL=m
CONFIG_RTL8852BS=m
CONFIG_RC_CORE=m
CONFIG_MEDIA_RC_SUPPORT=y
CONFIG_IR_GPIO_CIR=m
CONFIG_INPUT_EVDEV=m
CONFIG_HID=m
CONFIG_HID_GENERIC=m

# Storage for VM/container workloads
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
CONFIG_LOOP=m
CONFIG_BLK_DEV_NBD=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_MD=y
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_ZRAM=m
