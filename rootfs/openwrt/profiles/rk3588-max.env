# EasePi R2 OpenWrt max profile.
# Source this from build-openwrt-image.sh after validating:
#   OPENWRT_PROFILE=rk3588-max bash build-image.sh openwrt 25 6.18 ext4

OPENWRT_PROFILE_ID="rk3588-max"
OPENWRT_PROFILE_DESCRIPTION="EasePi R2 RK3588 max feature profile"
OPENWRT_RELEASES="24 25"
OPENWRT_KERNEL_SERIES="6.18"
OPENWRT_KERNEL_LOCALVERSION_DEFAULT="-easepi-r2-rk3588-max"

OPENWRT_DEVICE_TARGET="rockchip/armv8"
OPENWRT_DEVICE_PROFILE="linkease_easepi-r2"
OPENWRT_DTS_NAME="rk3588-easepi-r2"
OPENWRT_UBOOT_DEVICE_NAME="easepi-r2-rk3588"
OPENWRT_IMAGE_TYPES="squashfs ext4"

OPENWRT_PACKAGE_LIST="rootfs/openwrt/packages/rk3588-max.txt"
OPENWRT_KERNEL_FRAGMENT="rootfs/openwrt/kernel/rk3588-max.fragment"

# Build a complete matching kmod feed, but only preinstall the curated max set.
# Installing literally every kmod into firmware is a size and boot-risk trap.
OPENWRT_KMOD_STRATEGY_DEFAULT="build-all-preinstall-max"
OPENWRT_BUILD_ALL_KMODS_DEFAULT="yes"
OPENWRT_PREINSTALL_MODE_DEFAULT="max"
OPENWRT_LOCAL_KMOD_FEED_DEFAULT="yes"

OPENWRT_FEATURES="gpu npu vpu kvm vfio lxc docker redroid vpn 4g bluetooth wifi ir storage"
